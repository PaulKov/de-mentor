ARG HIVE_VERSION=3.1.3
ARG POSTGRESQL_JDBC_VERSION=42.7.7

FROM maven:3.9.9-eclipse-temurin-17 AS postgres-jdbc
ARG POSTGRESQL_JDBC_VERSION=42.7.7
RUN mvn -B org.apache.maven.plugins:maven-dependency-plugin:3.7.1:copy \
      -Dartifact=org.postgresql:postgresql:${POSTGRESQL_JDBC_VERSION} \
      -DoutputDirectory=/drivers

FROM apache/hive:${HIVE_VERSION}
ARG POSTGRESQL_JDBC_VERSION=42.7.7
COPY --from=postgres-jdbc /drivers/postgresql-${POSTGRESQL_JDBC_VERSION}.jar /opt/hive/lib/postgres.jar
